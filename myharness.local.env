# MyHarness 설정 읽기 순서
# 1. 이 파일(myharness.local.env)의 비어 있지 않은 값
# 2. 현재 Windows/프로세스 환경변수
# 3. P-GPT만 .myharness/credentials.json의 저장값
#
# 같은 이름의 값이 여러 곳에 있으면 위쪽 소스가 우선합니다.
# 이 파일에서 값이 비어 있으면 기존 환경변수를 덮어쓰지 않습니다.
# API 키가 포함될 수 있으므로 이 파일을 Git에 커밋하거나 공유하지 마세요.
#
# API 설정 예시(필요한 항목의 주석을 제거하여 사용):
# PGPT_API_KEY=
# PGPT_EMPLOYEE_NO=
# PGPT_COMPANY_CODE=30
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
#
# 이 폴더에서만 적용되는 실행 포트 설정입니다.
# 프로그램 폴더를 여러 개 복사해서 동시에 실행할 때는 복사본마다 PORT를 다르게 바꾸세요.
PORT=4273

# 개발용 런처(run_myharness_web_dev.bat)에서만 쓰는 React/Vite 화면 포트입니다.
# 일반 실행(run_myharness_web.bat)만 쓸 때는 신경 쓰지 않아도 됩니다.
MYHARNESS_DEV_PORT=4173

# 1: 같은 포트를 쓰는 기존 프로세스를 강제로 종료하고 새로 실행합니다. 기존 런처와 같은 기본 동작입니다.
# 0: 포트가 이미 사용 중이면 기존 프로세스를 죽이지 않고 안내 후 종료합니다. 여러 복사본을 동시에 띄울 때는 0으로 바꾸세요.
MYHARNESS_CLOSE_PORT_PROCESS=1
