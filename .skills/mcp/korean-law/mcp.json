{
  "mcpServers": {
    "korean-law": {
      "type": "stdio",
      "command": "node",
      "args": [
        "runtime/node_modules/korean-law-mcp/build/index.js"
      ],
      "env": {
        "LAW_OC": "myeongcheol",
        "NODE_OPTIONS": "--tls-cipher-list=DEFAULT@SECLEVEL=0",
        "LAW_API_PROTOCOL": "http"
      },
      "cwd": ".",
      "auto_connect": false,
      "description": "Korean Law MCP - 법제처 Open API 기반 법령, 판례, 행정규칙, 자치법규, 조약, 해석례 조회"
    }
  }
}
