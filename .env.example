# MyHarness API credential template.
# Copy the needed lines to API_KEY.env, then replace placeholders locally.
# The launchers load API_KEY.env, not this example file.
# Never commit real credentials or paste them into chat.

# Korea Customs Service trade statistics
KCS_TRADE_API_KEY=

# U.S. and international data sources
DATA_GOV_API_KEY=
CENSUS_API_KEY=
FRED_API_KEY=
WTO_API_KEY=

# Company and research sources
COMPANIES_HOUSE_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Japan / Korea public data
ESTAT_JP_APP_ID=
NABO_API_KEY=
KIPRIS_API_KEY=

# EPO OPS OAuth credentials
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=

# SEC fair-access identification (not a secret key)
SEC_USER_AGENT=CompanyName contact@example.com
